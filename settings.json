{
  "env": {
    "EDITOR": "cursor --wait",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Task(Explore)"
    ],
    "defaultMode": "dontAsk"
  },
  "model": "opus[1m]",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/scripts/statusline.sh\""
  },
  "enabledPlugins": {
    "axcli@agentic-builders-hub": false,
    "impeccable@impeccable": false,
    "playwright@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "transcripts@memories": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agentic-builders-hub": {
      "source": {
        "source": "github",
        "repo": "dapulse/agentic-builders-hub"
      }
    },
    "gsap-skills": {
      "source": {
        "source": "github",
        "repo": "greensock/gsap-skills"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "memories": {
      "source": {
        "source": "github",
        "repo": "Michael-Simkin/memories"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true
}
